<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="Persistencia">
        <!-- Representamos las clases -->
        <class>es.iesjuanbosco.model.Empleado</class>
        <class>es.iesjuanbosco.model.Departamento</class>
        <properties>
            <property name="hibernate.connection.provider_class"
                      value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
            <property name="hibernate.hikari.poolName" value="MiPoolDeConexiones"/>
            <property name="hibernate.hikari.maximumPoolSize" value="10"/>
            <property name="hibernate.hikari.connectionTimeout" value="20000"/>
            <property name="hibernate.hikari.jdbcUrl" value="jdbc:h2:mem:test"/>
            <property name="hibernate.hikari.driverClassName" value="org.h2.Driver"/>
            <property name="hibernate.hikari.username" value="sa"/>
            <property name="hibernate.hikari.password" value=""/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
        </properties>

    </persistence-unit>
</persistence>